# Cloudflare Pages response headers (copied into the build from public/).
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
/api/*
  X-Robots-Tag: noindex
